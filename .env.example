# Copia este archivo como .env y pega tu API key:
# cp .env.example .env
#
# Proveedor activo: groq o nvidia
LLM_PROVIDER=groq

# Limites para evitar que una consulta remota deje la interfaz esperando minutos
LLM_REQUEST_TIMEOUT=25
LLM_TOTAL_TIMEOUT=45

# Clave de API de GroqCloud (obtenida en https://console.groq.com/keys)
GROQ_API_KEY=gsk_tu_clave_aqui

# Modelo opcional (por defecto: llama-3.3-70b-versatile)
GROQ_MODEL=openai/gpt-oss-20b

# NVIDIA NIM / build.nvidia.com compatible con OpenAI
NVIDIA_API_KEY=nvapi_tu_clave_aqui
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=deepseek-ai/deepseek-v4-pro-0813
