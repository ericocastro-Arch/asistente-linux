# Copia este archivo como .env y pega tu API key:
# cp .env.example .env
#
# Proveedor activo: groq, nvidia, openai, anthropic, gemini, xai, together,
# deepseek, qwen, moonshot, zai, ollama o custom
LLM_PROVIDER=groq

# Limites para evitar que una consulta remota deje la interfaz esperando minutos
LLM_REQUEST_TIMEOUT=25
LLM_TOTAL_TIMEOUT=45
LLM_MAX_TOKENS=1500
LLM_TEMPERATURE=0.2

# Clave de API de GroqCloud (obtenida en https://console.groq.com/keys)
GROQ_API_KEY=gsk_tu_clave_aqui

# Modelo opcional (por defecto: llama-3.3-70b-versatile)
GROQ_MODEL=openai/gpt-oss-20b

# NVIDIA NIM / build.nvidia.com compatible con OpenAI
NVIDIA_API_KEY=nvapi_tu_clave_aqui
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=deepseek-ai/deepseek-v4-pro-0813

# Cada proveedor admite <PROVEEDOR>_API_KEY, _MODEL y _BASE_URL.
# Configuracion permite editar estos valores y consultar el catalogo real.
DEEPSEEK_API_KEY=
QWEN_API_KEY=
MOONSHOT_API_KEY=
ZAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
TOGETHER_API_KEY=
OPENAI_API_KEY=

# Para APIs compatibles adicionales, configura los tres campos.
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=
