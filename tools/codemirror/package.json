{
  "name": "linuxmate-codemirror-bundle",
  "private": true,
  "version": "1.0.0",
  "description": "Construye el bundle local de CodeMirror 6 que usa el Módulo Dev (sin CDN en tiempo de ejecución).",
  "scripts": {
    "build": "esbuild entry.js --bundle --minify --format=iife --global-name=CM --target=es2020 --outfile=../../src/gui/web/vendor/codemirror/cm6.bundle.js"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-css": "^6.3.0",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.3",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/lang-python": "^6.1.7",
    "@codemirror/language": "^6.11.0",
    "@codemirror/legacy-modes": "^6.5.0",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@lezer/highlight": "^1.2.1",
    "codemirror": "^6.0.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
